---
import { getCollection } from 'astro:content';
import PersonalLayout from '../../layouts/PersonalLayout.astro';

// Drop a new markdown file in src/content/notes and it appears here,
// on the timeline and in its year section, automatically.
const notes = (await getCollection('notes'))
  .filter((n) => import.meta.env.DEV || !n.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const base = import.meta.env.BASE_URL || '/';
const normalizeBase = base === '/' ? '' : base.replace(/\/$/, '');
const withBase = (path: string) => (path.startsWith('/') ? `${normalizeBase}${path}` : path);
const isoDate = (d: Date) => d.toISOString().slice(0, 10);

// Group by year, newest year first.
const notesByYear = new Map<number, typeof notes>();
for (const note of notes) {
  const year = note.data.pubDate.getFullYear();
  notesByYear.set(year, [...(notesByYear.get(year) ?? []), note]);
}
const years = [...notesByYear.keys()].sort((a, b) => b - a);

const languages = [...new Set(notes.map((n) => (n.data.lang ?? 'en').toUpperCase()))];

// ---- timeline geometry --------------------------------------------------
// The track spans whole years (Jan 1 of the earliest year → Jan 1 after the
// latest), so year boundaries sit at honest positions. Each note becomes a
// tick placed by its date. With a 4% inset the edge ticks stay visible.
const minYear = years.length ? Math.min(...years) : new Date().getFullYear();
const maxYear = years.length ? Math.max(...years) : new Date().getFullYear();
const t0 = Date.UTC(minYear, 0, 1);
const t1 = Date.UTC(maxYear + 1, 0, 1);
const span = Math.max(1, t1 - t0);
const pos = (d: Date) => 4 + ((d.getTime() - t0) / span) * 92;

const ticks = notes.map((note) => ({
  left: pos(note.data.pubDate),
  href: withBase(`/notes/${note.slug}/`),
  label: `${isoDate(note.data.pubDate)} — ${note.data.title}`,
}));
const yearLabels = [];
for (let y = minYear; y <= maxYear + 1; y++) {
  yearLabels.push({ year: y, left: 4 + ((Date.UTC(y, 0, 1) - t0) / span) * 92 });
}
---
<PersonalLayout
  current="notes"
  title="Arkiv — Alberto Ferreira de Melo"
  description="Every note in the notebook, on one timeline."
>
  <main class="wrap">
    <header class="arkiv-head">
      <p class="section-label">Arkiv</p>
      <h1>Anteckningar</h1>
      <p class="arkiv-count">
        {notes.length} {notes.length === 1 ? 'note' : 'notes'} &middot; {languages.join(' / ')} &middot; {minYear}{maxYear > minYear ? `–${maxYear}` : ''}
      </p>
    </header>

    <nav class="timeline" aria-label="Notes on a timeline">
      <div class="timeline-track">
        {ticks.map((tick) => (
          <a class="timeline-tick" style={`left:${tick.left}%`} href={tick.href} title={tick.label}>
            <span class="sr-only">{tick.label}</span>
          </a>
        ))}
      </div>
      <div class="timeline-years" aria-hidden="true">
        {yearLabels.map((y) => (
          <span style={`left:${y.left}%`}>{y.year}</span>
        ))}
      </div>
      <p class="timeline-caption">one tick per note &mdash; hover for the title, click to open</p>
    </nav>

    {years.length > 1 && (
      <nav class="year-jump" aria-label="Jump to a year">
        {years.map((year) => (
          <a href={`#y${year}`}>{year} <span class="n">{notesByYear.get(year)!.length}</span></a>
        ))}
      </nav>
    )}

    {years.map((year) => (
      <section class="year-section" id={`y${year}`} aria-label={`Notes from ${year}`}>
        <div class="year-sticky">
          <p class="year-numeral">
            {year}
            <small>{notesByYear.get(year)!.length} {notesByYear.get(year)!.length === 1 ? 'note' : 'notes'}</small>
          </p>
        </div>
        <div class="notes-list">
          {notesByYear.get(year)!.map((note) => (
            <a class="note" href={withBase(`/notes/${note.slug}/`)}>
              <span class="n-date">{isoDate(note.data.pubDate)}</span>
              <span class="n-main">
                <span class="n-title">{note.data.title}</span>
                <span class="n-desc">{note.data.description}</span>
              </span>
              <span class="n-lang">{(note.data.lang ?? 'en').toUpperCase()}</span>
            </a>
          ))}
        </div>
      </section>
    ))}

    {notes.length === 0 && <p class="arkiv-count">Nothing here yet.</p>}
  </main>
</PersonalLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  main { padding-bottom: 4.5rem; }
</style>

---
import { getCollection } from 'astro:content';
import PersonalLayout from '../../layouts/PersonalLayout.astro';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
  );
  // The list is newest-first, so index+1 is the older note.
  return notes.map((note, i) => ({
    params: { slug: note.slug },
    props: {
      note,
      newer: i > 0 ? notes[i - 1] : null,
      older: i < notes.length - 1 ? notes[i + 1] : null,
    },
  }));
}

const { note, newer, older } = Astro.props;
const { data, body } = note;
const { Content } = await note.render();

const base = import.meta.env.BASE_URL || '/';
const normalizeBase = base === '/' ? '' : base.replace(/\/$/, '');
const withBase = (path: string) => (path.startsWith('/') ? `${normalizeBase}${path}` : path);

const imageUrl = data.image ? withBase(data.image) : null;
const language = (data.lang ?? 'en').toUpperCase();
const isoDate = data.pubDate.toISOString().slice(0, 10);
const words = body.split(/\s+/).filter(Boolean).length;
const readMinutes = Math.max(1, Math.round(words / 200));
---
<PersonalLayout
  current="notes"
  title={`${data.title} — Alberto Ferreira de Melo`}
  description={data.description}
>
  <main class="wrap">
    <article class="article">
      <a class="crumb" href={withBase('/notes/')}>&larr; Arkiv</a>

      <header>
        <p class="article-meta">
          <time datetime={data.pubDate.toISOString()}>{isoDate}</time>
          <span class="lang">{language}</span>
          <span>{readMinutes}&nbsp;min</span>
        </p>
        <h1>{data.title}</h1>
        <p class="standfirst">{data.description}</p>
      </header>

      <hr class="article-rule" />

      {imageUrl && (
        <figure class="article-figure">
          <img src={imageUrl} alt="" loading="lazy" decoding="async" />
        </figure>
      )}

      <div class="prose">
        <Content />
      </div>

      {(newer || older) && (
        <nav class="pager" aria-label="Older and newer notes">
          {newer && (
            <a href={withBase(`/notes/${newer.slug}/`)} class="prev">
              <span class="dir">&larr; Newer</span>
              <span class="t">{newer.data.title}</span>
            </a>
          )}
          {older && (
            <a href={withBase(`/notes/${older.slug}/`)} class="next">
              <span class="dir">Older &rarr;</span>
              <span class="t">{older.data.title}</span>
            </a>
          )}
        </nav>
      )}
    </article>
  </main>
</PersonalLayout>

<style>
  main { padding-bottom: 4.5rem; }
</style>

---
import { getCollection } from 'astro:content';
import PersonalLayout from '../layouts/PersonalLayout.astro';

const allNotes = (await getCollection('notes'))
  .filter((n) => import.meta.env.DEV || !n.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const base = import.meta.env.BASE_URL || '/';
const normalizeBase = base === '/' ? '' : base.replace(/\/$/, '');
const withBase = (path: string) => (path.startsWith('/') ? `${normalizeBase}${path}` : path);
const isoDate = (d: Date) => d.toISOString().slice(0, 10);

const wordCount = (body: string) => body.split(/\s+/).filter(Boolean).length;
const languages = [...new Set(allNotes.map((n) => n.data.lang ?? 'en'))];
const aiWords = allNotes
  .filter((n) => n.data.ai && n.data.ai !== 'none')
  .reduce((sum, n) => sum + wordCount(n.body), 0);
const indexLabel = `Index — ${allNotes.length} ${allNotes.length === 1 ? 'note' : 'notes'} · ${languages.length} ${languages.length === 1 ? 'language' : 'languages'} · ${aiWords} AI-written words`;

// Rows interleaved with a marker whenever the year changes (list is newest-first).
const rows: Array<{ type: 'note'; note: (typeof allNotes)[number] } | { type: 'year'; year: number }> = [];
let lastYear: number | null = null;
for (const note of allNotes) {
  const y = note.data.pubDate.getFullYear();
  if (lastYear !== null && y !== lastYear) rows.push({ type: 'year', year: y });
  rows.push({ type: 'note', note });
  lastYear = y;
}

// The plot is the notebook's own record: one strand-cluster per note,
// placed by date, sized by word count, inked by language. Deterministic —
// it changes only when a note is published.
const plotData = allNotes.map((n) => ({
  t: n.data.pubDate.getTime(),
  words: wordCount(n.body),
  sv: (n.data.lang ?? 'en') === 'sv',
  seed: n.slug,
}));
const svCount = plotData.filter((p) => p.sv).length;
const firstYear = allNotes.length
  ? Math.min(...allNotes.map((n) => n.data.pubDate.getFullYear()))
  : new Date().getFullYear();
---
<PersonalLayout current="index">
  <section class="hero" id="hero" aria-label="A drawing generated from this notebook's notes">
    <canvas id="plot" aria-hidden="true"></canvas>
    <div class="wrap">
      <div class="masthead" id="masthead">
        <p class="eyebrow">Anteckningar</p>
        <h1>Ferreira<br />de&nbsp;Melo</h1>
        <p class="subtitle">Data, design och offentlig sektor &mdash; a notebook kept in public.</p>
      </div>
    </div>
    <p class="plot-caption" id="plotCaption">
      plot n&ordm;&nbsp;{allNotes.length} &mdash; one strand per note, placed by date<br />
      length = words{svCount > 0 && ' · red ink = svenska'} &middot; changes only when a note is published
    </p>
  </section>

  <main class="wrap">
    <section class="notes" aria-label="Notes index">
      <h2 class="section-label">{indexLabel}</h2>
      <div class="notes-list">
        {rows.map((row) =>
          row.type === 'year' ? (
            <div class="year-marker" aria-hidden="true">&mdash;&nbsp;{row.year}</div>
          ) : (
            <a class="note" href={withBase(`/notes/${row.note.slug}/`)}>
              <span class="n-date">{isoDate(row.note.data.pubDate)}</span>
              <span class="n-main">
                <span class="n-title">{row.note.data.title}</span>
                <span class="n-desc">{row.note.data.description}</span>
              </span>
              <span class="n-lang">{(row.note.data.lang ?? 'en').toUpperCase()}</span>
            </a>
          ),
        )}
      </div>
    </section>

    <section class="about" aria-label="About">
      <h2 class="about-label">About &mdash; Om</h2>
      <div class="about-text">
        <p>
          Alberto Ferreira de Melo works in public service, on data and design &mdash; mostly on
          making AI transparent and genuinely useful. From Brazil, based in Sweden.
        </p>
        <p>
          Notes are in English or Swedish, whichever language the thought came in. Each one ends
          with an <a href={withBase('/about/')}>innehållsdeklaration</a> &mdash; a declaration of
          how it was made.
        </p>
      </div>
    </section>
  </main>

  <script is:inline id="plot-data" type="application/json" set:html={JSON.stringify({ notes: plotData, firstYear })} />
  <script is:inline>
    (function () {
      'use strict';
      var hero = document.getElementById('hero');
      var mast = document.getElementById('masthead');
      var canvas = document.getElementById('plot');
      var caption = document.getElementById('plotCaption');
      var dataEl = document.getElementById('plot-data');
      if (!hero || !mast || !canvas || !caption || !dataEl) return;
      var ctx = canvas.getContext('2d');
      var NOTES = [];
      try { NOTES = JSON.parse(dataEl.textContent).notes || []; } catch (e) { return; }

      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var DRAW_MS = 6000; // the plot lands in ~6 s — an entrance, not an endurance test

      // Deterministic PRNG per note: the same notebook draws the same plot
      // for every visitor. No Math.random anywhere.
      function hash32(str) {
        var h = 2166136261;
        for (var i = 0; i < str.length; i++) {
          h ^= str.charCodeAt(i);
          h = Math.imul(h, 16777619);
        }
        return h >>> 0;
      }
      function mulberry32(s) {
        return function () {
          s |= 0; s = (s + 0x6d2b79f5) | 0;
          var t = Math.imul(s ^ (s >>> 15), 1 | s);
          t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
      }

      var W, H, zone, raf = null;
      var inkCol = '#16324F', penCol = '#C33D1F', hairCol = '#E3E1D9';

      function readColors() {
        var cs = getComputedStyle(document.documentElement);
        inkCol = cs.getPropertyValue('--line').trim() || inkCol;
        penCol = cs.getPropertyValue('--pen2').trim() || penCol;
        hairCol = cs.getPropertyValue('--hair').trim() || hairCol;
      }

      function inZone(x, y, pad) {
        return x > zone.x0 - pad && x < zone.x1 + pad && y > zone.y0 - pad && y < zone.y1 + pad;
      }

      // Build every stroke segment up front (deterministic), then reveal
      // them over DRAW_MS. Each note = a cluster of strands rising from its
      // date position on a ghost time axis; strand steps ∝ word count.
      function buildSegments() {
        var segs = [];
        if (!NOTES.length) return segs;

        var minT = Infinity, maxT = -Infinity;
        NOTES.forEach(function (n) { if (n.t < minT) minT = n.t; if (n.t > maxT) maxT = n.t; });
        // Pad the axis to whole years so positions stay honest as notes arrive.
        var y0 = new Date(minT).getUTCFullYear();
        var y1 = new Date(maxT).getUTCFullYear() + 1;
        var t0 = Date.UTC(y0, 0, 1), t1 = Date.UTC(y1, 0, 1);
        var span = Math.max(1, t1 - t0);
        var xL = W * 0.07, xR = W * 0.93;
        var baseY = H * 0.8;

        // Ghost axis: hairline + a tick per year boundary.
        for (var yy = y0; yy <= y1; yy++) {
          var tx = xL + ((Date.UTC(yy, 0, 1) - t0) / span) * (xR - xL);
          segs.push({ x0: tx, y0: baseY - 5, x1: tx, y1: baseY + 5, ink: 'hair' });
        }
        var AXIS_STEP = 14;
        for (var ax = xL; ax < xR; ax += AXIS_STEP) {
          var ax1 = Math.min(ax + AXIS_STEP - 3, xR);
          if (!inZone(ax, baseY, 24) && !inZone(ax1, baseY, 24)) {
            segs.push({ x0: ax, y0: baseY, x1: ax1, y1: baseY, ink: 'hair' });
          }
        }

        NOTES.forEach(function (n) {
          var rand = mulberry32(hash32(n.seed + ':' + n.t));
          var xd = xL + ((n.t - t0) / span) * (xR - xL);
          var strands = 4 + Math.floor(rand() * 3);
          var totalSteps = Math.max(140, Math.min(2600, n.words * 2.2));
          var stepsPer = Math.round(totalSteps / strands);
          var A = 0.004 + rand() * 0.008;
          var B = 0.004 + rand() * 0.008;
          var phase = rand() * 6.283;

          for (var s = 0; s < strands; s++) {
            var x = xd + (rand() - 0.5) * 26;
            var y = baseY - rand() * 8;
            var drift = 0.55 + rand() * 0.5; // upward pull
            var sway = (rand() - 0.5) * 1.1;
            for (var st = 0; st < stepsPer; st++) {
              var a = Math.sin(y * A + phase) + Math.cos(x * B) + sway;
              var vx = Math.cos(a) * 0.9;
              var vy = -drift + Math.sin(a * 1.7) * 0.55;
              var vl = Math.hypot(vx, vy) || 1;
              var nx = x + (vx / vl) * 1.7;
              var ny = y + (vy / vl) * 1.7;
              if (ny < H * 0.06 || nx < 4 || nx > W - 4 || ny > baseY + 6) break;
              if (inZone(nx, ny, 14)) break; // strands stop at the masthead's paper
              segs.push({ x0: x, y0: y, x1: nx, y1: ny, ink: n.sv ? 'pen' : 'ink' });
              x = nx; y = ny;
            }
          }
        });
        return segs;
      }

      var segments = [];

      function paint(upTo) {
        ctx.clearRect(0, 0, W, H);
        ctx.lineWidth = 1;
        ctx.lineCap = 'round';
        var groups = { hair: [], ink: [], pen: [] };
        for (var i = 0; i < upTo; i++) groups[segments[i].ink].push(segments[i]);
        [['hair', hairCol, 0.9], ['ink', inkCol, 0.42], ['pen', penCol, 0.5]].forEach(function (g) {
          var list = groups[g[0]];
          if (!list.length) return;
          ctx.beginPath();
          list.forEach(function (sg) { ctx.moveTo(sg.x0, sg.y0); ctx.lineTo(sg.x1, sg.y1); });
          ctx.globalAlpha = g[2];
          ctx.strokeStyle = g[1];
          ctx.stroke();
        });
        ctx.globalAlpha = 1;
      }

      var startTs = null;
      function loop(ts) {
        if (startTs === null) startTs = ts;
        var k = Math.min(1, (ts - startTs) / DRAW_MS);
        // Ease-out: the pen sprints early, settles at the end.
        var eased = 1 - Math.pow(1 - k, 2.2);
        paint(Math.round(segments.length * eased));
        if (k < 1) { raf = requestAnimationFrame(loop); }
        else { raf = null; caption.classList.add('show'); }
      }

      function init(animate) {
        if (raf) { cancelAnimationFrame(raf); raf = null; }
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        W = hero.clientWidth; H = hero.clientHeight;
        canvas.width = Math.max(1, Math.round(W * dpr));
        canvas.height = Math.max(1, Math.round(H * dpr));
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        readColors();

        var hr = hero.getBoundingClientRect();
        var mr = mast.getBoundingClientRect();
        var m = W < 680 ? 12 : 26;
        zone = {
          x0: mr.left - hr.left - m, y0: mr.top - hr.top - m,
          x1: mr.right - hr.left + m, y1: mr.bottom - hr.top + m,
        };

        segments = buildSegments();
        startTs = null;
        caption.classList.remove('show');
        if (animate && !reduced && segments.length) {
          raf = requestAnimationFrame(loop);
        } else {
          paint(segments.length);
          caption.classList.add('show');
        }
      }

      // Theme change: same plot, new inks — instant redraw, no re-animation.
      var mq = window.matchMedia('(prefers-color-scheme: dark)');
      var onTheme = function () { init(false); };
      if (mq.addEventListener) mq.addEventListener('change', onTheme);
      else if (mq.addListener) mq.addListener(onTheme);
      new MutationObserver(function (muts) {
        for (var i = 0; i < muts.length; i++) {
          if (muts[i].attributeName === 'data-theme') { onTheme(); return; }
        }
      }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

      var rt = null, lastW = 0, lastH = 0;
      window.addEventListener('resize', function () {
        clearTimeout(rt);
        rt = setTimeout(function () {
          if (hero.clientWidth === lastW && hero.clientHeight === lastH) return;
          lastW = hero.clientWidth; lastH = hero.clientHeight;
          init(false);
        }, 250);
      });
      lastW = hero.clientWidth; lastH = hero.clientHeight;

      init(true);
    })();
  </script>
</PersonalLayout>
